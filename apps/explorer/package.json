{
  "name": "@resurrect-protocol/explorer",
  "version": "0.0.0",
  "private": true,
  "description": "Static browser explorer and authenticated peer probe for Resurrect",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @resurrect-protocol/client build",
    "build": "tsc --noEmit && vite build",
    "precheck": "pnpm --filter @resurrect-protocol/client build",
    "check": "tsc --noEmit",
    "dev": "vite",
    "preview": "vite preview",
    "pretest": "pnpm --filter @resurrect-protocol/client build",
    "test": "vitest run"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/identify": "4.1.14",
    "@libp2p/ping": "3.1.13",
    "@libp2p/websockets": "10.1.21",
    "@multiformats/multiaddr": "13.0.3",
    "@resurrect-protocol/client": "workspace:*",
    "libp2p": "3.3.11"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
